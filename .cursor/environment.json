{
  "name": "AGRITAIRE",
  "install": "npm ci\nnpm run build",
  "start": "npm run preview -- --host 0.0.0.0 --port 4173",
  "ports": [
    {
      "name": "AGRITAIRE (free to play)",
      "port": 4173
    },
    {
      "name": "vite dev",
      "port": 5173
    }
  ],
  "terminals": [
    {
      "name": "vite dev",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "description": "Hot-reload game for development at http://localhost:5173"
    }
  ]
}
